{
  "name": "agendaspro-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && vite build --ssr src/entry-server.js --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "serve:dist": "node scripts/serve-dist.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.2.5",
    "@unhead/vue": "^2.1.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@vitejs/plugin-vue": "^5.2.3",
    "tailwindcss": "^4.1.8",
    "vite": "^6.2.4",
    "vitest": "^3.2.0"
  }
}
