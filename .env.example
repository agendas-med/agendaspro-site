# Copie para .env.local (nunca versione valores reais). Todas as variáveis são públicas no bundle (VITE_*).

# URL pública deste site (canonical, OG, sitemap)
VITE_SITE_URL=https://agendaspro.com.br
# Painel (agendaspro-system): destino de /registro e /entrar
VITE_APP_URL=https://app.agendaspro.com.br
# Base da API do core (rotas /public/*). Deve ser o mesmo host liberado em connect-src do CSP.
VITE_API_BASE=https://api.agendaspro.com.br
# true = usa fixtures locais (src/services/mockApi.js), sem backend. Em produção deixe false.
VITE_USE_MOCKS=false
# Slug de uma página pública de exemplo ("ver exemplo"); em mock usa clinica-exemplo
VITE_DEMO_SLUG=

# Cloudflare Turnstile (site key pública; a secret fica só no core). Vazio = widget oculto.
VITE_TURNSTILE_SITE_KEY=

# WhatsApp comercial (somente dígitos com DDI, ex.: 5511999999999). Vazio = botão de WhatsApp oculto.
VITE_WHATSAPP_NUMBER=

# Preço do Premium em centavos (usado na calculadora de comissão)
VITE_PLAN_PREMIUM_PRICE_CENTS=4990

# Analytics: só carregam após consentimento no banner de cookies. Vazio = desativado.
VITE_GA4_ID=
VITE_META_PIXEL_ID=
VITE_CLARITY_ID=

# Chat com IA: placeholder, desligado até o core expor o endpoint
VITE_CHAT_ENABLED=false
